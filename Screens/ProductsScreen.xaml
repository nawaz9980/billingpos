<UserControl x:Class="QuickPos.Screens.ProductsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             Loaded="UserControl_Loaded">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Product Catalog (SQLite)" Foreground="#0F172A" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Add and manage items stored in the local SQLite database" Foreground="#64748B" FontSize="12.5" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Quick Add Product Form -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Code *" Foreground="#475569" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtCode" Height="30" Padding="6,4" BorderBrush="#CBD5E1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Product Name *" Foreground="#475569" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtName" Height="30" Padding="6,4" BorderBrush="#CBD5E1"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Alias" Foreground="#475569" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtAlias" Height="30" Padding="6,4" BorderBrush="#CBD5E1"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Stock" Foreground="#475569" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtStock" Height="30" Padding="6,4" BorderBrush="#CBD5E1" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Rate *" Foreground="#475569" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtRate" Height="30" Padding="6,4" BorderBrush="#CBD5E1"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="GST" Foreground="#475569" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtGst" Height="30" Padding="6,4" BorderBrush="#CBD5E1" Text="8%"/>
                </StackPanel>

                <Button Grid.Column="6" Content="+ Add Product" Background="#4F46E5" Foreground="#FFFFFF"
                        FontWeight="Bold" Height="30" Padding="16,0" VerticalAlignment="Bottom"
                        BorderThickness="0" Cursor="Hand" Click="AddProduct_Click"/>
            </Grid>
        </Border>

        <!-- Products DataGrid -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="2">
            <DataGrid x:Name="GridCatalog" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      Background="#FFFFFF" BorderThickness="0" GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0"
                      RowHeight="28" FontSize="13">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4F46E5"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sno" Binding="{Binding Sno}" Width="55"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="140"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat='{}{0:F2}'}" Width="90"/>
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat='{}{0:F2}'}" Width="95"/>
                    <DataGridTextColumn Header="GST" Binding="{Binding Gst}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
