<UserControl x:Class="QuickPos.Screens.SalesReturnScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:QuickPos.Components"
             Background="#F1F5F9"
             Focusable="True"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FKeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ LEFT: FILTER BAR + RETURN ITEMS GRID + ACTIONS ══════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- Row 0: Date From, Date To, Bill Number Search Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Loaded Bill Info Strip -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Sold Items Grid with Return Checkboxes -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Bottom Function Keys -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Classic "Select Bill" Card (Hides automatically once a bill is loaded) -->
            <Border Grid.Row="0" x:Name="SelectBillPanel" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Width="440" HorizontalAlignment="Left" Margin="12,10,12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Select Bill Header -->
                    <Border Grid.Row="0" Background="#4F46E5" CornerRadius="5,5,0,0" Padding="12,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="Select Bill" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <Button Content="📋 List Bills (F5)" HorizontalAlignment="Right" Background="#3730A3" Foreground="#FFFFFF"
                                    BorderThickness="0" FontWeight="Bold" FontSize="11.5" Padding="10,4" Cursor="Hand" Click="OpenBillsList_Click"/>
                        </Grid>
                    </Border>

                    <!-- 2-Column Table: Date From, Date To, Counter, Bill No -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Date From -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                            <TextBlock Text="Date From" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,2">
                            <DatePicker x:Name="DpDateFrom" BorderThickness="0" Background="Transparent" FontSize="12.5" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- Date To -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                            <TextBlock Text="Date To" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,2">
                            <DatePicker x:Name="DpDateTo" BorderThickness="0" Background="Transparent" FontSize="12.5" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- Counter -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                            <TextBlock Text="Counter" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBox x:Name="TxtCounter" BorderThickness="0" Background="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                                     Padding="8,2" VerticalContentAlignment="Center" KeyDown="TxtBillNoInput_KeyDown"/>
                        </Border>

                        <!-- Bill No -->
                        <Border Grid.Row="3" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                            <TextBlock Text="Bill No" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1">
                            <TextBox x:Name="TxtBillNoInput" BorderThickness="0" Background="#FEF3C7" Foreground="#0F172A"
                                     FontSize="13" FontWeight="Bold" Padding="8,2" VerticalContentAlignment="Center"
                                     ToolTip="Type Bill No and press Enter (or leave empty and press Enter to browse)"
                                     KeyDown="TxtBillNoInput_KeyDown"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 1: Loaded Bill Metadata Strip (Shown once bill is loaded, with button to load new bill) -->
            <Border Grid.Row="1" x:Name="LoadedBillStrip" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" Padding="12,7" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Loaded Bill: " Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLoadedBillNo" Text="-" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" Margin="0,0,16,0"/>
                        <TextBlock Text="Date: " Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLoadedDate" Text="-" Foreground="#0F172A" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <TextBlock Text="Customer: " Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLoadedCustomer" Text="-" Foreground="#0F172A" FontSize="12" FontWeight="Bold" Margin="0,0,16,0"/>
                        <TextBlock Text="Orig Amt: " Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLoadedOrigAmt" Text="0.00" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleAll" Content="☑ Select All" Background="#EEF2FF" Foreground="#4338CA"
                                BorderBrush="#C7D2FE" BorderThickness="1" FontWeight="Bold" FontSize="11.5"
                                Height="28" Padding="10,0" Cursor="Hand" Click="ToggleSelectAll_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Sold Items Grid with Multi-Select Checkboxes & Return Qty -->
            <DataGrid Grid.Row="2" x:Name="GridReturnItems"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      RowHeight="30"
                      FontSize="13"
                      Foreground="#0F172A"
                      SelectionMode="Single"
                      CellEditEnding="GridReturnItems_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Return" Width="62">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Cursor="Hand" Checked="ReturnCheck_Changed" Unchecked="ReturnCheck_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Item Description" Binding="{Binding Item}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat='{}{0:F2}'}" Width="85" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Sold Qty" Binding="{Binding SoldQty}" Width="78" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Return Qty" Binding="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged}" Width="88"/>
                    <DataGridTextColumn Header="Dis %" Binding="{Binding DiscPct, StringFormat='{}{0:F0}'}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Refund Amt" Binding="{Binding RefundAmount, StringFormat='{}{0:F2}'}" Width="105" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 3: Bottom Toolbar -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="6,6">
                <UniformGrid Columns="5" Rows="1">
                    <Button Style="{StaticResource FKeyBtn}" Click="OpenBillsList_Click">
                        <StackPanel>
                            <TextBlock Text="F5" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="List Bills" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="ViewReturnedBills_Click">
                        <StackPanel>
                            <TextBlock Text="F6" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="View Bills" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="ProcessReturn_Click">
                        <StackPanel>
                            <TextBlock Text="F2" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Save" Foreground="#10B981" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="ClearReturn_Click">
                        <StackPanel>
                            <TextBlock Text="F7" Foreground="#EF4444" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Clear" Foreground="#EF4444" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="CloseReturn_Click">
                        <StackPanel>
                            <TextBlock Text="F12" Foreground="#475569" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Close" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>

        <!-- ══════════════ RIGHT: RETURN SUMMARY & RRN TENDER ══════════════ -->
        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12,14,12">

                    <!-- Return Summary Breakdown -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RETURN SUMMARY" Foreground="#4F46E5" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8"/>

                            <Grid Margin="0,3">
                                <TextBlock Text="Selected Items" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock x:Name="TxtSelectedCount" Text="0" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Return Qty" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock x:Name="TxtReturnQtyTotal" Text="0" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Sub Total" Foreground="#0F172A" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtReturnSubTot" Text="0.00" Foreground="#0F172A" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="GST Refund (8%)" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock x:Name="TxtReturnTax" Text="0.00" Foreground="#0F172A" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Rounding" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock x:Name="TxtReturnRounding" Text="0.00" Foreground="#64748B" FontSize="12.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Big Total Refund Box -->
                    <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Refund" Foreground="#1E40AF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotalRefund" Text="0.00" Foreground="#DC2626" FontSize="34" FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Return Reason Card -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="RETURN REASON" Foreground="#4F46E5" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbReturnReason" Height="32" FontSize="12" SelectedIndex="0">
                                <ComboBoxItem Content="Customer Changed Mind"/>
                                <ComboBoxItem Content="Damaged / Defective Item"/>
                                <ComboBoxItem Content="Wrong Size / Product"/>
                                <ComboBoxItem Content="Billing Error"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Primary Action Button (Save Only - Opens Cash & RRN Tender Overlay) -->
                    <Button Content="✔ Save Return (F2)" Background="#4F46E5" Foreground="#FFFFFF"
                            FontWeight="Bold" FontSize="13" Height="42" BorderThickness="0" Cursor="Hand"
                            Click="ProcessReturn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════ BILLS PICKER OVERLAY (Right Side Window) ══════════════ -->
        <components:ViewBillsOverlay x:Name="ReturnBillsOverlay"
                                     Grid.ColumnSpan="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Visibility="Collapsed"/>

        <!-- ══════════════ RETURNED BILLS HISTORY OVERLAY (Right Side Window) ══════════════ -->
        <components:ViewBillsOverlay x:Name="ReturnedBillsOverlay"
                                     Grid.ColumnSpan="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Visibility="Collapsed"/>

        <!-- ══════════════ RETURN TENDER OVERLAY (Cash & RRN Only, Centered) ══════════════ -->
        <components:PaymentTenderOverlay x:Name="ReturnTenderOverlay"
                                         Grid.ColumnSpan="2"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         Visibility="Collapsed"/>
    </Grid>
</UserControl>
