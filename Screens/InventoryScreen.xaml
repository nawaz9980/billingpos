<UserControl x:Class="QuickPos.Screens.InventoryScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <StackPanel Margin="32,24,32,24">
        <TextBlock Text="Inventory &amp; Stock Balance" Foreground="#0F172A" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="Monitor stock levels, warehouse transfers, and supplier orders" Foreground="#64748B" FontSize="13" Margin="0,4,0,20"/>
        
        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
            <TextBlock Text="📦 Real-time inventory tracking module." Foreground="#64748B" FontSize="13"/>
        </Border>
    </StackPanel>
</UserControl>
