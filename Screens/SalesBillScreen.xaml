<UserControl x:Class="QuickPos.Screens.SalesBillScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:QuickPos.Components"
             Background="#F1F5F9"
             Focusable="True"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <!-- Modern DataGrid Header matching TopMenuBar theme -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Clean DataGrid Row Style: Prevents harsh blue fill across whole row -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style: Highlights ONLY the clicked or navigated cell -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#3730A3"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Function Key Button Style (F1 - F12) -->
        <Style x:Key="FKeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left 80%: Main Billing Grid & Actions -->
            <ColumnDefinition Width="*"/>
            <!-- Right 20%: Bill Summary & Totals -->
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ LEFT: BILLING DATA GRID & FUNCTION KEYS ══════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- Row 0: Quick barcode/item entry row -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Main Data Grid -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Status & Quick Tender Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: F1-F12 Function Keys Toolbar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Customer Entry Strip + Quick Item Entry Input -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,8">
                <StackPanel>
                    <!-- Customer Details Card (Compact left-aligned, not full width) -->
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"
                            Width="440" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Customer Details -->
                            <Border Grid.Row="0" Background="#4F46E5" CornerRadius="3,3,0,0" Padding="10,0">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="Customer Details" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCustomerStatus" Text="Enter mobile number &amp; press Enter"
                                               Foreground="#E0E7FF" FontSize="11.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2-Row Table: Mobile Number & Name Only -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Mobile Number -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Mobile Number" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <TextBox x:Name="TxtCustomerPhone" MaxLength="10" BorderThickness="0" FontSize="12.5" FontWeight="SemiBold" Padding="8,2"
                                             VerticalContentAlignment="Center" PreviewTextInput="DigitsOnly_PreviewTextInput" KeyDown="TxtCustomerPhone_KeyDown">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Border>

                                <!-- Row 1: Name -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                                    <TextBlock Text="Name" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1">
                                    <TextBox x:Name="TxtCustomerName" BorderThickness="0" FontSize="12.5" FontWeight="SemiBold" Padding="8,2"
                                             VerticalContentAlignment="Center" KeyDown="TxtCustomerName_KeyDown">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Barcode / Item Scan Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Scan Barcode / Code:" Foreground="#475569" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="2,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtBarcodeEntry" Height="30" FontSize="13" Padding="6,4"
                                 BorderBrush="#4F46E5" BorderThickness="1.5" VerticalAlignment="Center"
                                 KeyDown="TxtBarcodeEntry_KeyDown"/>
                        
                        <Button Grid.Column="2" Content="+ Add Line (Enter)" Background="#4F46E5" Foreground="#FFFFFF"
                                FontWeight="Bold" Height="30" Padding="14,0" Margin="8,0,10,0" BorderThickness="0"
                                Cursor="Hand" Click="AddLine_Click"/>

                        <!-- Held Bills Status Indicator & Tab Switch Hint -->
                        <Border Grid.Column="3" x:Name="HeldStatusBadge" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="8,4" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="HeldStatusBadge_MouseLeftButtonDown" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtHeldHint" Text="⏸️ 1 Bill on Hold [Press Tab to switch]" Foreground="#92400E" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Close Current Bill button in header -->
                        <Button Grid.Column="4" x:Name="BtnCloseCurrentBill" Content="✕ Close Bill"
                                Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1"
                                FontWeight="Bold" FontSize="11.5" Height="30" Padding="10,0" Cursor="Hand"
                                Click="CloseBill_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Row 1: Bill Items DataGrid -->
            <DataGrid Grid.Row="1" x:Name="GridBillItems"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      RowHeight="28"
                      FontSize="13"
                      Foreground="#0F172A"
                      SelectionUnit="Cell"
                      SelectionMode="Single"
                      CellEditEnding="GridBillItems_CellEditEnding">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4F46E5"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#4F46E5"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="Item Description" Binding="{Binding Item}" Width="*"/>
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat='{}{0:F2}'}" Width="85"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="65"/>
                    <DataGridTextColumn Header="Dis %" Binding="{Binding DiscPct, StringFormat='{}{0:F0}'}" Width="65"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:F2}'}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="SalesMan" Binding="{Binding SalesMan}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 2: Status Strip -->
            <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,1" Padding="6,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#4F46E5" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="SERVE" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Text="Status: Online  |  Rows: " Foreground="#475569" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtRowCount" Text="0" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="Tot Qty: " Foreground="#475569" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTotalQty" Text="0" Foreground="#0F172A" FontSize="11.5" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Row 3: F1-F12 Function Keys Toolbar -->
            <Border Grid.Row="3" Background="#FFFFFF" Padding="4,6">
                <UniformGrid Columns="8" Rows="1">
                    <Button Style="{StaticResource FKeyBtn}" Click="AddSampleItem_Click">
                        <StackPanel>
                            <TextBlock Text="F1" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add Item" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="SaveAndPrint_Click">
                        <StackPanel>
                            <TextBlock Text="F2" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Save" Foreground="#10B981" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="SalesReturn_Click">
                        <StackPanel>
                            <TextBlock Text="F3" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sales Rtn" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="ViewBills_Click">
                        <StackPanel>
                            <TextBlock Text="F5" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="View Bills" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="ClearBill_Click">
                        <StackPanel>
                            <TextBlock Text="F7" Foreground="#EF4444" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Clear" Foreground="#EF4444" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="HoldBill_Click">
                        <StackPanel>
                            <TextBlock Text="F10" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hold Bill" Foreground="#B45309" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="SelectCustomer_Click">
                        <StackPanel>
                            <TextBlock Text="F11" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select Cust" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="CloseBill_Click">
                        <StackPanel>
                            <TextBlock Text="F12" Foreground="#475569" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Close" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>

        <!-- ══════════════ RIGHT: BILL SUMMARY & GRAND TOTAL ══════════════ -->
        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12,14,12">

                    <!-- Header Meta Info Table -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Text="Session" Foreground="#64748B" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="1 (Morning)" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Bill Date" Foreground="#64748B" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtBillDate" Text="23/11/2026" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Bill No" Foreground="#64748B" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtBillNo" Text="#1043-1" Foreground="#4F46E5" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid x:Name="RowHeldCount" Margin="0,2" Visibility="Collapsed">
                                <TextBlock Text="Active Bill:" Foreground="#B45309" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtActiveBillCount" Text="1 of 2 (Tab to switch)" Foreground="#B45309" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Price Breakdown Fields -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <TextBlock Text="Gross" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock x:Name="TxtGross" Text="0.00" Foreground="#0F172A" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Item Offer / Disc" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock x:Name="TxtItemOffer" Text="0.00" Foreground="#10B981" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Sub Total" Foreground="#0F172A" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtSubTot" Text="0.00" Foreground="#0F172A" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock x:Name="TxtCgstLabel" Text="CGST (2.5%)" Foreground="#64748B" FontSize="12"/>
                                <TextBlock x:Name="TxtCgst" Text="0.00" Foreground="#0F172A" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock x:Name="TxtSgstLabel" Text="SGST (2.5%)" Foreground="#64748B" FontSize="12"/>
                                <TextBlock x:Name="TxtSgst" Text="0.00" Foreground="#0F172A" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock x:Name="TxtTaxLabel" Text="GST Tax" Foreground="#64748B" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtTax" Text="0.00" Foreground="#0F172A" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Rounding" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock x:Name="TxtRounding" Text="0.00" Foreground="#64748B" FontSize="12.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Big Highlighted Grand Total Box -->
                    <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Due" Foreground="#1E40AF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtGrandTotal" Text="0.00" Foreground="#DC2626" FontSize="36" FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tender & Change Inputs -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <TextBlock Text="Tendered:" Foreground="#475569" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtTendered" Text="0.00" Width="95" Height="26" FontSize="13" FontWeight="Bold"
                                         HorizontalAlignment="Right" TextAlignment="Right" Padding="4,2"
                                         BorderBrush="#94A3B8" TextChanged="TxtTendered_TextChanged"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Change Given:" Foreground="#166534" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtChangeGiven" Text="0.00" Foreground="#166534" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Direct Thermal Print Button -->
                    <Button Content="🖨️ Print Thermal Receipt" Background="#4F46E5" Foreground="#FFFFFF"
                            FontWeight="Bold" FontSize="13" Height="40" BorderThickness="0" Cursor="Hand"
                            Click="SaveAndPrint_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════ PRODUCTS LIST FLOATING OVERLAY (Right Side Panel) ══════════════ -->
        <components:ProductLookupOverlay x:Name="ProductOverlay"
                                         Grid.ColumnSpan="2"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,10,48"
                                         Visibility="Collapsed"/>

        <!-- ══════════════ PAYMENT TENDER MODAL OVERLAY (Centered in Middle) ══════════════ -->
        <components:PaymentTenderOverlay x:Name="TenderOverlay"
                                         Grid.ColumnSpan="2"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         Visibility="Collapsed"/>

        <!-- ══════════════ VIEW BILLS OVERLAY (Right Side Window) ══════════════ -->
        <components:ViewBillsOverlay x:Name="BillsOverlay"
                                     Grid.ColumnSpan="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Visibility="Collapsed"/>

        <!-- ══════════════ CUSTOMERS LIST OVERLAY (Right Side Window) ══════════════ -->
        <components:CustomerLookupOverlay x:Name="CustomerOverlay"
                                          Grid.ColumnSpan="2"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Visibility="Collapsed"/>
    </Grid>
</UserControl>
