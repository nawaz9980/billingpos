<UserControl x:Class="QuickPos.Screens.DistributorsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:QuickPos.Components"
             Background="#400F172A"
             Focusable="True"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="RowLabelBorder" TargetType="Border">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="RowLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E1B4B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowInputBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="RowInputBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowComboBox" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FKeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Centered Modal / Overlay Card -->
        <Border Background="#F1F5F9"
                BorderBrush="#94A3B8"
                BorderThickness="1.5"
                CornerRadius="8"
                Width="880"
                Height="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- Row 0: Window Title Strip -->
        <Border Grid.Row="0" Background="#E0E7FF" BorderBrush="#C7D2FE" BorderThickness="0,0,0,1" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Distributor Master" Foreground="#1E1B4B" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtTotalCount" Text="Total Distributors: 0" Foreground="#4338CA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Row 1: Mode Banner (Blue/Indigo theme) -->
        <Border Grid.Row="1" x:Name="ModeBanner" Background="#4F46E5" Padding="12,7">
            <TextBlock x:Name="TxtModeBanner" Text="(Mode - new) : Creating new record"
                       Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
        </Border>

        <!-- Row 2: Tabbed Property Sheet -->
        <TabControl Grid.Row="2" x:Name="MainTabs" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="8,8,8,4">
            <!-- TAB 1: DETAILS -->
            <TabItem Header="Details" FontSize="12.5" FontWeight="SemiBold" Padding="14,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Background="#FFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <!-- 0: * Code -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="* Code" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtCode" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 1: * Name -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="* Name" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtName" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 2: Short Name -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Short Name" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtShortName" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 3: Location -->
                        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Location" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtLocation" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 4: Landmark -->
                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Landmark" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtLandmark" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 5: Place/City -->
                        <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Place/City" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtCity" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 6: State -->
                        <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="State" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                            <ComboBox x:Name="CmbState" Style="{StaticResource RowComboBox}" IsEditable="True">
                                <ComboBoxItem Content="Tamil Nadu"/>
                                <ComboBoxItem Content="Karnataka"/>
                                <ComboBoxItem Content="Kerala"/>
                                <ComboBoxItem Content="Andhra Pradesh"/>
                                <ComboBoxItem Content="Telangana"/>
                                <ComboBoxItem Content="Maharashtra"/>
                                <ComboBoxItem Content="Delhi"/>
                                <ComboBoxItem Content="Gujarat"/>
                            </ComboBox>
                        </Border>

                        <!-- 7: Country -->
                        <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Country" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                            <ComboBox x:Name="CmbCountry" Style="{StaticResource RowComboBox}" IsEditable="True" Text="India">
                                <ComboBoxItem Content="India"/>
                                <ComboBoxItem Content="UAE"/>
                                <ComboBoxItem Content="USA"/>
                                <ComboBoxItem Content="UK"/>
                            </ComboBox>
                        </Border>

                        <!-- 8: Pin Code -->
                        <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Pin Code" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="8" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtPinCode" Style="{StaticResource RowInputBox}" MaxLength="10" PreviewTextInput="NumericOnly_PreviewTextInput"/></Border>

                        <!-- 9: Tel No. Office -->
                        <Border Grid.Row="9" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Tel No. Office" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="9" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtTelOffice" Style="{StaticResource RowInputBox}" MaxLength="15" PreviewTextInput="NumericOnly_PreviewTextInput"/></Border>

                        <!-- 10: Mobile -->
                        <Border Grid.Row="10" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Mobile" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="10" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtPhone" Style="{StaticResource RowInputBox}" MaxLength="10" PreviewTextInput="NumericOnly_PreviewTextInput"/></Border>

                        <!-- 11: Email -->
                        <Border Grid.Row="11" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Email" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="11" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtEmail" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 12: Fax -->
                        <Border Grid.Row="12" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Fax" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="12" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtFax" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 13: Inventory Type -->
                        <Border Grid.Row="13" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Inventory Type" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="13" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                            <ComboBox x:Name="CmbType" Style="{StaticResource RowComboBox}" SelectedIndex="0">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Local"/>
                                <ComboBoxItem Content="Interstate"/>
                                <ComboBoxItem Content="Manufacturer"/>
                                <ComboBoxItem Content="Wholesaler"/>
                                <ComboBoxItem Content="C&amp;F"/>
                            </ComboBox>
                        </Border>

                        <!-- 14: Currency Name -->
                        <Border Grid.Row="14" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Currency Name" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="14" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                            <ComboBox x:Name="CmbCurrency" Style="{StaticResource RowComboBox}" IsEditable="True" SelectedIndex="0">
                                <ComboBoxItem Content="INR"/>
                                <ComboBoxItem Content="USD"/>
                                <ComboBoxItem Content="AED"/>
                                <ComboBoxItem Content="EUR"/>
                            </ComboBox>
                        </Border>

                        <!-- 15: Tel No. Res -->
                        <Border Grid.Row="15" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Tel No. Res" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="15" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtTelRes" Style="{StaticResource RowInputBox}" MaxLength="15" PreviewTextInput="NumericOnly_PreviewTextInput"/></Border>

                        <!-- 16: Distributor ID -->
                        <Border Grid.Row="16" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Distributor ID" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="16" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtDistributorId" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 17: * Area -->
                        <Border Grid.Row="17" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="* Area" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="17" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtArea" Style="{StaticResource RowInputBox}"/></Border>

                        <!-- 18: Barcode Alias -->
                        <Border Grid.Row="18" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Barcode Alias" Style="{StaticResource RowLabelText}"/></Border>
                        <Border Grid.Row="18" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtBarcodeAlias" Style="{StaticResource RowInputBox}"/></Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: CONTACT -->
            <TabItem Header="Contact" FontSize="12.5" FontWeight="SemiBold" Padding="14,5">
                <Grid Background="#FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Contact Person" Style="{StaticResource RowLabelText}"/></Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtContactPerson" Style="{StaticResource RowInputBox}"/></Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Full Address (for Invoice)" Style="{StaticResource RowLabelText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtAddress" Style="{StaticResource RowInputBox}"/></Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Comments / Notes" Style="{StaticResource RowLabelText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                        <TextBox x:Name="TxtComments" Style="{StaticResource RowInputBox}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: GST -->
            <TabItem Header="GST" FontSize="12.5" FontWeight="SemiBold" Padding="14,5">
                <Grid Background="#FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="GSTIN / Tax No" Style="{StaticResource RowLabelText}"/></Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtGstNo" Style="{StaticResource RowInputBox}" CharacterCasing="Upper"/></Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="PAN No" Style="{StaticResource RowLabelText}"/></Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtPanNo" Style="{StaticResource RowInputBox}" CharacterCasing="Upper" MaxLength="10"/></Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="GST Reg. Type" Style="{StaticResource RowLabelText}"/></Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                        <ComboBox x:Name="CmbGstRegType" Style="{StaticResource RowComboBox}" SelectedIndex="0">
                            <ComboBoxItem Content="Regular"/>
                            <ComboBoxItem Content="Composition"/>
                            <ComboBoxItem Content="Unregistered"/>
                            <ComboBoxItem Content="SEZ"/>
                        </ComboBox>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Credit Days" Style="{StaticResource RowLabelText}"/></Border>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtCreditDays" Style="{StaticResource RowInputBox}" Text="0" PreviewTextInput="NumericOnly_PreviewTextInput"/></Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: ORDER DAYS -->
            <TabItem Header="Order Days" FontSize="12.5" FontWeight="SemiBold" Padding="14,5">
                <StackPanel Margin="16" Orientation="Vertical">
                    <TextBlock Text="Select Preferred Order Days:" Foreground="#1E1B4B" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkMon" Content="Monday" Margin="0,0,18,10" FontSize="12.5" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkTue" Content="Tuesday" Margin="0,0,18,10" FontSize="12.5" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkWed" Content="Wednesday" Margin="0,0,18,10" FontSize="12.5" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkThu" Content="Thursday" Margin="0,0,18,10" FontSize="12.5" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkFri" Content="Friday" Margin="0,0,18,10" FontSize="12.5" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkSat" Content="Saturday" Margin="0,0,18,10" FontSize="12.5" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkSun" Content="Sunday" Margin="0,0,18,10" FontSize="12.5" FontWeight="SemiBold"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Row 3: Legend / Hint Strip -->
        <Border Grid.Row="3" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,1" Padding="12,4">
            <TextBlock Foreground="#4338CA" FontSize="11.5" FontWeight="SemiBold"
                       Text="▼ - Select from dropdown   •   Enter - Move to next field   •   F4 / F5 - Pick existing distributor to Edit or View"/>
        </Border>

        <!-- Row 4: Bottom F-Key Toolbar -->
        <Border Grid.Row="4" Background="#F1F5F9" Padding="6,4">
            <UniformGrid Rows="1" Columns="11">
                <Button Style="{StaticResource FKeyBtn}" Click="Help_Click">
                    <StackPanel>
                        <TextBlock Text="F1" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Help" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="New_Click">
                    <StackPanel>
                        <TextBlock Text="F3" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="New" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="EditPick_Click">
                    <StackPanel>
                        <TextBlock Text="F4" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Edit" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="EditPick_Click">
                    <StackPanel>
                        <TextBlock Text="F5" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="View" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="Save_Click">
                    <StackPanel>
                        <TextBlock Text="F6" Foreground="#10B981" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Save" Foreground="#10B981" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="Clear_Click">
                    <StackPanel>
                        <TextBlock Text="F7" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Clear" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="Skip_Click">
                    <StackPanel>
                        <TextBlock Text="F8" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Skip" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="Default_Click">
                    <StackPanel>
                        <TextBlock Text="F9" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Default" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnDelete" Style="{StaticResource FKeyBtn}" IsEnabled="False" Click="Delete_Click">
                    <StackPanel>
                        <TextBlock Text="F10" Foreground="#EF4444" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Delete" Foreground="#EF4444" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="Comments_Click">
                    <StackPanel>
                        <TextBlock Text="F11" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Comments" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FKeyBtn}" Click="Close_Click">
                    <StackPanel>
                        <TextBlock Text="F12" Foreground="#475569" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Text="Close" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
            </Grid>
        </Border>

        <!-- Centered Distributor Picker Overlay (for F4 Edit / F5 View) -->
        <components:DistributorLookupOverlay x:Name="DistLookupOverlay"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed"/>
    </Grid>
</UserControl>
