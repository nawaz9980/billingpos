<UserControl x:Class="QuickPos.Components.CustomerLookupOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="CustomerGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Right-side Floating Overlay Window -->
    <Border Background="#FFFFFF" BorderBrush="#4F46E5" BorderThickness="2" CornerRadius="6"
            Width="620" Height="480" Margin="0,0,10,48">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Border Grid.Row="0" Background="#4F46E5" CornerRadius="4,4,0,0" Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Customers List (Click Header to Sort)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5"/>
                    <TextBlock Grid.Column="2" x:Name="TxtRecordsCount" Text="Records : 0/0" Foreground="#E0E7FF" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="✕" Background="Transparent" Foreground="#E0E7FF" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4,2" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Row 1: Filter Search Box -->
            <Border Grid.Row="1" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search Name / Mobile:" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtSearch" Background="#FEF3C7" BorderBrush="#4F46E5" BorderThickness="1"
                             FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Padding="8,2" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- Row 2: Sortable Customers DataGrid (Default sorted by Name) -->
            <DataGrid Grid.Row="2" x:Name="GridCustomers"
                      ColumnHeaderStyle="{StaticResource CustomerGridHeaderStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      Sorting="GridCustomers_Sorting"
                      SelectionChanged="GridCustomers_SelectionChanged"
                      PreviewKeyDown="GridCustomers_PreviewKeyDown"
                      MouseDoubleClick="GridCustomers_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sno" Binding="{Binding Sno}" Width="55" SortMemberPath="Sno"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding CustCode}" Width="75" SortMemberPath="CustCode"/>
                    <DataGridTextColumn Header="Customer Name ▲" Binding="{Binding Name}" Width="*" SortMemberPath="Name"/>
                    <DataGridTextColumn Header="Mobile Number" Binding="{Binding Phone}" Width="160" SortMemberPath="Phone"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 3: Footer -->
            <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="0,0,4,4" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="[↑/↓] Navigate  •  [Enter / Double-Click] Import Customer  •  [Esc] Close" Foreground="#64748B" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Import to Bill (Enter)" HorizontalAlignment="Right" Background="#4F46E5" Foreground="#FFFFFF"
                            FontSize="11.5" FontWeight="Bold" Padding="12,4" BorderThickness="0" Cursor="Hand" Click="SelectCustomer_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
