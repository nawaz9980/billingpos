<UserControl x:Class="QuickPos.Components.ProductLookupOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <!-- DataGrid Header matching POS list style from screenshot -->
        <Style x:Key="ProductGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#CA8A04"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#A16207"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- DataGrid Row Style with Wine/Maroon selection like the screenshot -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#881337"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Overlay Card with drop shadow, anchored to bottom-right -->
    <Border Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="1.5" CornerRadius="6" Width="820" Height="540">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header with Title, Record Counter & Close -->
                <RowDefinition Height="34"/>
                <!-- Row 1: Fast Filter Search Input -->
                <RowDefinition Height="40"/>
                <!-- Row 2: Products DataGrid -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Navigation Hint Footer -->
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title bar -->
            <Border Grid.Row="0" Background="#BAE6FD" BorderBrush="#94A3B8" BorderThickness="0,0,0,1" Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Products List" Foreground="#0F172A" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="2" x:Name="TxtRecordsCount" Text="Records : 1/20" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0"/>
                    <Button Grid.Column="3" Content="✕" Background="Transparent" Foreground="#475569" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4,2" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Row 1: Search Box (Yellow themed like screenshot) -->
            <Border Grid.Row="1" Background="#FEF9C3" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,4">
                <TextBox x:Name="TxtSearch" Background="#FEF9C3" BorderBrush="#CA8A04" BorderThickness="1.5"
                         FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Padding="8,4"
                         TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
            </Border>

            <!-- Row 2: Product Table -->
            <DataGrid Grid.Row="2" x:Name="GridProducts"
                      ColumnHeaderStyle="{StaticResource ProductGridHeaderStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      PreviewKeyDown="GridProducts_PreviewKeyDown"
                      SelectionChanged="GridProducts_SelectionChanged"
                      MouseDoubleClick="GridProducts_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sno" Binding="{Binding Sno}" Width="50"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="75"/>
                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="120"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat='{}{0:F2}'}" Width="85"/>
                    <DataGridTextColumn Header="Landing" Binding="{Binding Rate, StringFormat='{}{0:F2}'}" Width="95"/>
                    <DataGridTextColumn Header="GST" Binding="{Binding Gst}" Width="65"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 3: Footer Keyboard Hints -->
            <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="[↑/↓] Select Row  •  [Enter] Add to Bill  •  [Esc] Close" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                    <Button Content="Add to Bill (Enter)" HorizontalAlignment="Right" Background="#4F46E5" Foreground="#FFFFFF"
                            FontSize="12" FontWeight="Bold" Padding="12,4" BorderThickness="0" Cursor="Hand" Click="SelectProduct_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
