<UserControl x:Class="QuickPos.Components.PaymentTenderOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <!-- Style for Left Tender Type Labels (Blue/Indigo UI theme) -->
        <Style x:Key="TenderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#1E1B4B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,6,0"/>
        </Style>

        <!-- Style for Right Tender Value Inputs with clean POS Amber active highlight -->
        <Style x:Key="TenderInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FEF3C7"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="CaretBrush" Value="#0F172A"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Bottom Action Buttons -->
        <Style x:Key="TenderBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E0E7FF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Semi-transparent modal backdrop -->
    <Grid Background="#660F172A">
        <!-- Floating Centered Tender Dialog Window -->
        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Width="480"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.38"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Window Title Bar "Tender" -->
                    <RowDefinition Height="40"/>
                    <!-- Row 1: Tender Rows Table -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Summary Block (Navy Blue Theme) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Action Buttons: Save [No Print], Save, Cancel -->
                    <RowDefinition Height="54"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title Bar -->
                <Border Grid.Row="0" Background="#4F46E5" CornerRadius="7,7,0,0" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="Tender" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                Foreground="#E0E7FF" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="Cancel_Click"/>
                    </Grid>
                </Border>

                <!-- Row 1: Tender Table Grid (Cash, UPI, Debit Card, RRN) -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left: Soft Blue category column -->
                            <ColumnDefinition Width="165"/>
                            <!-- Right: Input values column -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition x:Name="RowDefUpi" Height="38"/>
                            <RowDefinition x:Name="RowDefDebitCard" Height="38"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>

                        <!-- A. Cash -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                            <TextBlock Text="A. Cash" Style="{StaticResource TenderLabelStyle}"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBox x:Name="TxtCash" Style="{StaticResource TenderInputStyle}"
                                     TextChanged="Amount_TextChanged" PreviewKeyDown="TenderInput_PreviewKeyDown"
                                     PreviewTextInput="DecimalInput_PreviewTextInput" DataObject.Pasting="DecimalInput_Pasting"/>
                        </Border>

                        <!-- B. UPI -->
                        <Border x:Name="CellUpiLabel" Grid.Row="1" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                            <TextBlock Text="B. UPI" Style="{StaticResource TenderLabelStyle}"/>
                        </Border>
                        <Border x:Name="CellUpiInput" Grid.Row="1" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBox x:Name="TxtUpi" Style="{StaticResource TenderInputStyle}"
                                     TextChanged="Amount_TextChanged" PreviewKeyDown="TenderInput_PreviewKeyDown"
                                     PreviewTextInput="DecimalInput_PreviewTextInput" DataObject.Pasting="DecimalInput_Pasting"/>
                        </Border>

                        <!-- C. Debit Card -->
                        <Border x:Name="CellDebitLabel" Grid.Row="2" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,1">
                            <TextBlock Text="C. Debit Card" Style="{StaticResource TenderLabelStyle}"/>
                        </Border>
                        <Border x:Name="CellDebitInput" Grid.Row="2" Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TextBox x:Name="TxtDebitCard" Style="{StaticResource TenderInputStyle}"
                                     TextChanged="Amount_TextChanged" PreviewKeyDown="TenderInput_PreviewKeyDown"
                                     PreviewTextInput="DecimalInput_PreviewTextInput" DataObject.Pasting="DecimalInput_Pasting"/>
                        </Border>

                        <!-- D. RRN (Retrieval Reference Number / Auth Code) -->
                        <Border Grid.Row="3" Grid.Column="0" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
                            <TextBlock x:Name="LblRrn" Text="D. RRN" Style="{StaticResource TenderLabelStyle}"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1">
                            <TextBox x:Name="TxtRrn" Style="{StaticResource TenderInputStyle}" HorizontalContentAlignment="Left"
                                     PreviewKeyDown="TenderInput_PreviewKeyDown"
                                     PreviewTextInput="DigitsOnly_PreviewTextInput" DataObject.Pasting="DigitsOnly_Pasting"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 2: Lower Summary Section (Deep Navy Blue Theme) -->
                <Border Grid.Row="2" Background="#0F172A" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Total -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Total" Foreground="#93C5FD" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSummaryTotal" Text="0.00" Foreground="#38BDF8" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <!-- Surcharge -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Surcharge" Foreground="#93C5FD" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="0.00" Foreground="#E2E8F0" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <!-- Advance(-) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Advance(-)" Foreground="#93C5FD" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="0.00" Foreground="#E2E8F0" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <!-- Tender Amount -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tender Amount" Foreground="#93C5FD" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtSummaryTendered" Text="0.00" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <!-- Balance -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Balance" Foreground="#93C5FD" FontWeight="Bold" FontSize="14.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtSummaryBalance" Text="0.00" Foreground="#EF4444" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Row 3: Action Buttons (Save [No Print], Save, Cancel) -->
                <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="0,0,7,7" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10,8">
                    <UniformGrid Columns="3" Rows="1">
                        <Button Style="{StaticResource TenderBtnStyle}" Content="Save [No Print]" Click="SaveNoPrint_Click"/>
                        <Button Background="#4F46E5" Foreground="#FFFFFF" BorderBrush="#4338CA" BorderThickness="1"
                                Height="36" Margin="4,0" FontSize="13" FontWeight="Bold" Cursor="Hand"
                                Content="Save" Click="SaveWithPrint_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="sb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="sb" Property="Background" Value="#4338CA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Style="{StaticResource TenderBtnStyle}" Content="Cancel" Click="Cancel_Click"/>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
