<UserControl x:Class="QuickPos.Components.TopMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="56"
             Background="#FFFFFF">

    <UserControl.Resources>
        <!-- Nav Item Button Style with smooth hover -->
        <Style x:Key="NavDropdownButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Icon Button Style -->
        <Style x:Key="CircleIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ContextMenu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
        <Grid Margin="14,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SECTION -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. Hamburger Menu -->
                <Button Style="{StaticResource CircleIconButtonStyle}" Width="34" Height="34" Click="Hamburger_Click">
                    <Path Stroke="#64748B" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 3,5 L 17,5 M 3,10 L 17,10 M 3,15 L 17,15" Width="20" Height="20" Stretch="Uniform"/>
                </Button>

                <!-- 2. Logo: QuickPOS (Clickable to go home/dashboard) -->
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Logo_Click" Margin="10,0,18,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="32" Height="32">
                                    <Border Background="#4F46E5" CornerRadius="8"/>
                                    <Canvas Width="32" Height="32">
                                        <Rectangle Canvas.Left="7" Canvas.Top="9" Width="15" Height="2.5" RadiusX="1.2" RadiusY="1.2" Fill="#FFFFFF"/>
                                        <Rectangle Canvas.Left="7" Canvas.Top="14.5" Width="18" Height="2.5" RadiusX="1.2" RadiusY="1.2" Fill="#FFFFFF"/>
                                        <Rectangle Canvas.Left="7" Canvas.Top="20" Width="11" Height="2.5" RadiusX="1.2" RadiusY="1.2" Fill="#FFFFFF"/>
                                        <Ellipse Canvas.Left="21" Canvas.Top="19" Width="6.5" Height="6.5" Fill="#F59E0B"/>
                                    </Canvas>
                                </Grid>
                                <TextBlock Text="QuickPOS" Foreground="#0F172A" FontSize="17" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 3. Nav Menus -->

                <!-- SALES -->
                <Button Style="{StaticResource NavDropdownButtonStyle}" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="POS Register (Sales Bill)" Click="NavMenuItem_Click" Tag="SalesBill"/>
                            <MenuItem Header="Orders &amp; Receipts" Click="NavMenuItem_Click" Tag="Orders"/>
                            <MenuItem Header="Held Bills" Click="NavMenuItem_Click" Tag="HeldBills"/>
                            <MenuItem Header="Refunds &amp; Returns" Click="NavMenuItem_Click" Tag="Refunds"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 6,2 L 3,6 L 3,20 C 3,21.1 3.9,22 5,22 L 19,22 C 20.1,22 21,21.1 21,20 L 21,6 L 18,2 Z M 3,6 L 21,6 M 16,10 C 16,12.2 14.2,14 12,14 C 9.8,14 8,12.2 8,10"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Sales" Foreground="#334155" FontSize="13.5" FontWeight="Medium" Margin="6,0,5,0" VerticalAlignment="Center"/>
                        <Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,7 L 10,12 L 15,7" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- PURCHASE -->
                <Button Style="{StaticResource NavDropdownButtonStyle}" Margin="4,0,0,0" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Purchase Invoice" Click="NavMenuItem_Click" Tag="PurchaseInvoice"/>
                            <MenuItem Header="Purchase Return" Click="NavMenuItem_Click" Tag="PurchaseReturn"/>
                            <Separator/>
                            <MenuItem Header="Master">
                                <MenuItem Header="Distributors" Click="NavMenuItem_Click" Tag="Distributors"/>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 6,2 L 18,2 L 18,22 L 15,20 L 12,22 L 9,20 L 6,22 Z M 9,7 L 15,7 M 9,11 L 15,11 M 9,15 L 13,15"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Purchase" Foreground="#334155" FontSize="13.5" FontWeight="Medium" Margin="6,0,5,0" VerticalAlignment="Center"/>
                        <Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,7 L 10,12 L 15,7" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- PRODUCTS -->
                <Button Style="{StaticResource NavDropdownButtonStyle}" Margin="4,0,0,0" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Product Catalog" Click="NavMenuItem_Click" Tag="Products"/>
                            <MenuItem Header="Price Lists" Click="NavMenuItem_Click" Tag="Products"/>
                            <MenuItem Header="Categories &amp; Brands" Click="NavMenuItem_Click" Tag="Products"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 21,16 L 21,8 L 12,2 L 3,8 L 3,16 L 12,22 Z M 3.3,7 L 12,12 L 20.7,7 M 12,22 L 12,12"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Products" Foreground="#334155" FontSize="13.5" FontWeight="Medium" Margin="6,0,5,0" VerticalAlignment="Center"/>
                        <Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,7 L 10,12 L 15,7" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- INVENTORY -->
                <Button Style="{StaticResource NavDropdownButtonStyle}" Margin="4,0,0,0" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Stock Balance" Click="NavMenuItem_Click" Tag="Inventory"/>
                            <MenuItem Header="Stock Receiving" Click="NavMenuItem_Click" Tag="Inventory"/>
                            <MenuItem Header="Suppliers" Click="NavMenuItem_Click" Tag="Inventory"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 2,4 L 22,4 L 22,17 L 2,17 Z M 8,21 L 16,21 M 12,17 L 12,21"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Inventory" Foreground="#334155" FontSize="13.5" FontWeight="Medium" Margin="6,0,5,0" VerticalAlignment="Center"/>
                        <Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,7 L 10,12 L 15,7" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- CUSTOMERS -->
                <Button Style="{StaticResource NavDropdownButtonStyle}" Margin="4,0,0,0" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Customer Directory" Click="NavMenuItem_Click" Tag="Customers"/>
                            <MenuItem Header="Loyalty Points" Click="NavMenuItem_Click" Tag="Customers"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 17,21 L 17,19 C 17,16.8 15.2,15 13,15 L 5,15 C 2.8,15 1,16.8 1,19 L 1,21 M 9,11 C 11.2,11 13,9.2 13,7 C 13,4.8 11.2,3 9,3 C 6.8,3 5,4.8 5,7 C 5,9.2 6.8,11 9,11 Z M 23,21 L 23,19 C 23,17.3 21.9,15.8 20.4,15.2 M 16,3.1 C 17.8,3.6 19,5.2 19,7 C 19,8.8 17.8,10.4 16,10.9"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Customers" Foreground="#334155" FontSize="13.5" FontWeight="Medium" Margin="6,0,5,0" VerticalAlignment="Center"/>
                        <Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,7 L 10,12 L 15,7" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- REPORTS -->
                <Button Style="{StaticResource NavDropdownButtonStyle}" Margin="4,0,0,0" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Daily Sales Report" Click="NavMenuItem_Click" Tag="Reports"/>
                            <MenuItem Header="Shift Summary" Click="NavMenuItem_Click" Tag="Reports"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 6,20 L 6,14 M 12,20 L 12,8 M 18,20 L 18,3"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Reports" Foreground="#334155" FontSize="13.5" FontWeight="Medium" Margin="6,0,5,0" VerticalAlignment="Center"/>
                        <Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,7 L 10,12 L 15,7" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- SETTINGS -->
                <Button Style="{StaticResource NavDropdownButtonStyle}" Margin="4,0,0,0" Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Store &amp; Thermal Printer Settings" Click="NavMenuItem_Click" Tag="Settings"/>
                            <MenuItem Header="Staff &amp; Permissions" Click="NavMenuItem_Click" Tag="Settings"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 12,15 C 13.66,15 15,13.66 15,12 C 15,10.34 13.66,9 12,9 C 10.34,9 9,10.34 9,12 C 9,13.66 10.34,15 12,15 Z M 19.4,15 L 21,12 L 19.4,9 L 16.8,9.5 L 15,7.5 L 15.5,5 L 12,4 L 10.5,5 L 9,7.5 L 7.2,9 L 4.6,9 L 3,12 L 4.6,15 L 7.2,15.5 L 9,17.5 L 8.5,20 L 12,21 L 13.5,20 L 15,17.5 Z"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" Foreground="#334155" FontSize="13.5" FontWeight="Medium" Margin="6,0,5,0" VerticalAlignment="Center"/>
                        <Path Stroke="#94A3B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5,7 L 10,12 L 15,7" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- RIGHT SECTION: Notifications, Search, User Avatar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. Notification Bell with Badge '3' -->
                <Button Style="{StaticResource CircleIconButtonStyle}" Click="Notification_Click">
                    <Grid Width="30" Height="30">
                        <Path Stroke="#64748B" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 18,8 C 18,4.7 15.3,2 12,2 C 8.7,2 6,4.7 6,8 C 6,15 3,17 3,17 L 21,17 C 21,17 18,15 18,8 Z M 13.7,21 C 13.4,21.6 12.7,22 12,22 C 11.3,22 10.6,21.6 10.3,21"
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="#EF4444" CornerRadius="8" Width="15" Height="15"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                            <TextBlock Text="3" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- 2. Search Icon -->
                <Button Style="{StaticResource CircleIconButtonStyle}" Margin="4,0,6,0" Click="Search_Click">
                    <Path Stroke="#64748B" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 10.5,18 C 14.6,18 18,14.6 18,10.5 C 18,6.4 14.6,3 10.5,3 C 6.4,3 3,6.4 3,10.5 C 3,14.6 6.4,18 10.5,18 Z M 21,21 L 15.8,15.8"
                          Width="18" Height="18" Stretch="Uniform"/>
                </Button>

                <!-- 3. User Avatar ('A') -->
                <Button Width="34" Height="34" Cursor="Hand" Click="Avatar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#5856D6" CornerRadius="17" Width="34" Height="34">
                                <TextBlock Text="A" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
