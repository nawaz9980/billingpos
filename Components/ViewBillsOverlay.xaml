<UserControl x:Class="QuickPos.Components.ViewBillsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <!-- Blue/Indigo Header matching QuickPOS UI theme -->
        <Style x:Key="BillsGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Clean Row Selection Highlight in Blue Theme -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Right-side Floating Overlay Window -->
    <Border Background="#FFFFFF" BorderBrush="#4F46E5" BorderThickness="2" CornerRadius="6,6,0,0"
            Width="1000" Height="540" Margin="0,0,4,0">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Title Bar -->
                <RowDefinition Height="38"/>
                <!-- Row 1: Quick Filter Bar -->
                <RowDefinition Height="38"/>
                <!-- Row 2: Bills DataGrid -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Footer Hint & Action -->
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Indigo Header -->
            <Border Grid.Row="0" Background="#4F46E5" CornerRadius="5,5,0,0" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="TxtHeaderTitle" Text="Last 50 bill(s) - View" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="2" x:Name="TxtRecordsCount" Text="Records : 1/20" Foreground="#E0E7FF" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="✕" Background="Transparent" Foreground="#E0E7FF" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4,2" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Row 1: Search / Filter Bar -->
            <Border Grid.Row="1" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search Bill No / Customer:" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtSearch" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1"
                             FontSize="12.5" Foreground="#0F172A" Padding="8,3" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- Row 2: Bills Table -->
            <DataGrid Grid.Row="2" x:Name="GridBills"
                      ColumnHeaderStyle="{StaticResource BillsGridHeaderStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      SelectionChanged="GridBills_SelectionChanged"
                      PreviewKeyDown="GridBills_PreviewKeyDown"
                      MouseDoubleClick="GridBills_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sno" Binding="{Binding Sno}" Width="48"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="95"/>
                    <DataGridTextColumn Header="BillNo" Binding="{Binding BillNo}" Width="75"/>
                    <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="58"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:F2}'}" Width="90"/>
                    <DataGridTextColumn Header="CustCode" Binding="{Binding CustCode}" Width="78"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*"/>
                    <DataGridTextColumn Header="User" Binding="{Binding User}" Width="72"/>
                    <DataGridTextColumn Header="Print" Binding="{Binding Print}" Width="55"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 3: Footer -->
            <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="0,0,5,5" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="[↑/↓] Select Bill  •  [Enter / Double-Click] View Details  •  [Esc] Close" Foreground="#64748B" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Close (Esc)" HorizontalAlignment="Right" Background="#4F46E5" Foreground="#FFFFFF"
                            FontSize="11.5" FontWeight="Bold" Padding="12,4" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
