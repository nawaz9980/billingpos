<UserControl x:Class="QuickPos.Components.QuickAddPurchaseItemOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#400F172A"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <Border Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="1.5" CornerRadius="8"
            Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.38"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#4F46E5" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="+ Quick Add Item (Local / Branded) to Purchase"
                               Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5"/>
                    <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#FFFFFF"
                            BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Form Body -->
            <StackPanel Grid.Row="1" Margin="16,14,16,10">
                <!-- Row 1: Item Name & HSN Code -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Item Name *" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtItemName" Height="30" Padding="7,4" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HSN Code" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtHsnCode" Height="30" Padding="7,4" BorderBrush="#CBD5E1" Text="6205"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="GST %" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbGst" Height="30" BorderBrush="#CBD5E1" SelectedIndex="0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="5%"/>
                            <ComboBoxItem Content="12%"/>
                            <ComboBoxItem Content="18%"/>
                            <ComboBoxItem Content="0%"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Row 1b: Brand & Style -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Brand" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtBrand" Height="30" Padding="7,4" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Style" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtStyle" Height="30" Padding="7,4" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Size (Custom or Multi-Size Checkboxes) -->
                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Size (single or tick multiple):" Foreground="#1E1B4B"
                                       FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtSize" Height="26" Padding="6,2" BorderBrush="#CBD5E1"
                                     ToolTip="Type a single size (e.g. L or Free) or tick sizes below"/>
                            <TextBlock Grid.Column="2" Text="(Each ticked size gets its own barcode)" Foreground="#4338CA"
                                       FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <WrapPanel x:Name="SizeChecksPanel">
                            <CheckBox Content="S" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                            <CheckBox Content="M" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                            <CheckBox Content="L" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                            <CheckBox Content="XL" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                            <CheckBox Content="XXL" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                            <CheckBox Content="38" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                            <CheckBox Content="40" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                            <CheckBox Content="42" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                            <CheckBox Content="44" Margin="0,0,0,0" FontWeight="SemiBold" Checked="SizeCheck_Changed" Unchecked="SizeCheck_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Row 3: Barcode (Scan Branded or Auto-Generate for Local) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Barcode (Scan Branded Barcode OR leave blank / Auto-Generate for Local Shirt)"
                                   Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtBarcode" Height="30" Padding="7,4" BorderBrush="#CBD5E1" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Auto-Generate" Background="#EEF2FF" Foreground="#4F46E5"
                            BorderBrush="#C7D2FE" BorderThickness="1" FontWeight="Bold" Height="30" Padding="12,0"
                            VerticalAlignment="Bottom" Cursor="Hand" Click="AutoGenerateBarcode_Click"/>
                </Grid>

                <!-- Row 4: Qty, Pur.Rate, MRP, Selling -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Qty *" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtQty" Height="30" Padding="7,4" BorderBrush="#CBD5E1" Text="1" HorizontalContentAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pur.Rate *" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtPurRate" Height="30" Padding="7,4" BorderBrush="#CBD5E1" Text="0.00" HorizontalContentAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="MRP" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtMrp" Height="30" Padding="7,4" BorderBrush="#CBD5E1" Text="0.00" HorizontalContentAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Selling Rate *" Foreground="#1E1B4B" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSelling" Height="30" Padding="7,4" BorderBrush="#CBD5E1" Text="0.00" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Enter moves to next field • F6 or Add saves item &amp; adds to Purchase"
                               Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel (Esc)" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1"
                                BorderThickness="1" FontWeight="SemiBold" Height="30" Padding="14,0" Margin="0,0,8,0"
                                Cursor="Hand" Click="Close_Click"/>
                        <Button x:Name="BtnAdd" Content="Add to Purchase (F6)" Background="#4F46E5" Foreground="#FFFFFF"
                                BorderThickness="0" FontWeight="Bold" Height="30" Padding="16,0"
                                Cursor="Hand" Click="Add_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
