<UserControl x:Class="QuickPos.Components.QuickAddPurchaseItemOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:QuickPos.Components"
             Background="#400F172A"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="RowLabelBorder" TargetType="Border">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="RowLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E1B4B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowInputBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="RowInputBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowComboBox" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FKeyBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root Grid to host Centered Modal + Bottom-Right Side Overlays -->
    <Grid>
        <!-- Centered Modal Card matching Distributor Master Blue/Indigo UI -->
        <Border Background="#F1F5F9"
            BorderBrush="#94A3B8"
            BorderThickness="1.5"
            CornerRadius="8"
            Width="720"
            Height="410"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.38"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Window Title Strip -->
            <Border Grid.Row="0" Background="#E0E7FF" BorderBrush="#C7D2FE" BorderThickness="0,0,0,1" Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Quick Item Creation" Foreground="#1E1B4B" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#1E1B4B"
                            BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Padding="4,0" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Row 1: Mode Banner -->
            <Border Grid.Row="1" Background="#4F46E5" Padding="12,7">
                <TextBlock Text="(Mode - new) : Creating new item (Local / Branded)"
                           Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
            </Border>

            <!-- Row 2: Single Tab Property Sheet -->
            <TabControl Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="8,8,8,4">
                <TabItem Header="Details" FontSize="12.5" FontWeight="SemiBold" Padding="16,5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Background="#FFFFFF">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <!-- 0: * Item Name -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="* Item Name" Style="{StaticResource RowLabelText}"/></Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtItemName" Style="{StaticResource RowInputBox}"/></Border>

                            <!-- 1: HSN Code -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="HSN Code" Style="{StaticResource RowLabelText}"/></Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource RowInputBorder}"><TextBox x:Name="TxtHsnCode" Style="{StaticResource RowInputBox}" Text="6205"/></Border>

                            <!-- 2: GST % -->
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="GST %" Style="{StaticResource RowLabelText}"/></Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                                <ComboBox x:Name="CmbGst" Style="{StaticResource RowComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="5%"/>
                                    <ComboBoxItem Content="12%"/>
                                    <ComboBoxItem Content="18%"/>
                                    <ComboBoxItem Content="0%"/>
                                </ComboBox>
                            </Border>

                            <!-- 3: Brand (Opens Bottom-Right Overlay) -->
                            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Brand" Style="{StaticResource RowLabelText}"/></Border>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtBrand" Style="{StaticResource RowInputBox}"
                                             PreviewMouseLeftButtonDown="TxtBrand_MouseDown"/>
                                    <Button Grid.Column="1" Content="Select ▾" Background="#EEF2FF" Foreground="#4F46E5"
                                            BorderBrush="#C7D2FE" BorderThickness="1" FontWeight="Bold" FontSize="11"
                                            Padding="10,2" Margin="4,3" Cursor="Hand" Click="OpenBrandOverlay_Click"/>
                                </Grid>
                            </Border>

                            <!-- 4: Style (Opens Bottom-Right Overlay) -->
                            <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Style" Style="{StaticResource RowLabelText}"/></Border>
                            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtStyle" Style="{StaticResource RowInputBox}"
                                             PreviewMouseLeftButtonDown="TxtStyle_MouseDown"/>
                                    <Button Grid.Column="1" Content="Select ▾" Background="#EEF2FF" Foreground="#4F46E5"
                                            BorderBrush="#C7D2FE" BorderThickness="1" FontWeight="Bold" FontSize="11"
                                            Padding="10,2" Margin="4,3" Cursor="Hand" Click="OpenStyleOverlay_Click"/>
                                </Grid>
                            </Border>

                            <!-- 5: Size (Opens Bottom-Right Multi-Select Overlay) -->
                            <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Size (Multi-Select)" Style="{StaticResource RowLabelText}"/></Border>
                            <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtSize" Style="{StaticResource RowInputBox}" IsReadOnly="True"
                                             PreviewMouseLeftButtonDown="TxtSize_MouseDown"/>
                                    <Button Grid.Column="1" Content="Select ▾" Background="#EEF2FF" Foreground="#4F46E5"
                                            BorderBrush="#C7D2FE" BorderThickness="1" FontWeight="Bold" FontSize="11"
                                            Padding="10,2" Margin="4,3" Cursor="Hand" Click="OpenSizeOverlay_Click"/>
                                </Grid>
                            </Border>

                            <!-- 6: Barcode -->
                            <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource RowLabelBorder}"><TextBlock Text="Barcode" Style="{StaticResource RowLabelText}"/></Border>
                            <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource RowInputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtBarcode" Style="{StaticResource RowInputBox}"/>
                                    <Button Grid.Column="1" Content="Auto-Generate" Background="#EEF2FF" Foreground="#4F46E5"
                                            BorderBrush="#C7D2FE" BorderThickness="1" FontWeight="Bold" FontSize="11"
                                            Padding="10,2" Margin="4,3" Cursor="Hand" Click="AutoGenerateBarcode_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Row 3: Legend / Hint Strip -->
            <Border Grid.Row="3" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,1" Padding="12,4">
                <TextBlock Foreground="#4338CA" FontSize="11.5" FontWeight="SemiBold"
                           Text="Enter - Move to next field   •   Leave Barcode blank to Auto-Generate   •   F6 - Save &amp; Add to Purchase"/>
            </Border>

            <!-- Row 4: Bottom F-Key Toolbar -->
            <Border Grid.Row="4" Background="#F1F5F9" Padding="6,4">
                <UniformGrid Rows="1" Columns="4">
                    <Button Style="{StaticResource FKeyBtn}" Click="Help_Click">
                        <StackPanel>
                            <TextBlock Text="F1" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Help" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAdd" Style="{StaticResource FKeyBtn}" Click="Add_Click">
                        <StackPanel>
                            <TextBlock Text="F6" Foreground="#10B981" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Save &amp; Add" Foreground="#10B981" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="Clear_Click">
                        <StackPanel>
                            <TextBlock Text="F7" Foreground="#4F46E5" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Clear" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FKeyBtn}" Click="Close_Click">
                        <StackPanel>
                            <TextBlock Text="F12" Foreground="#475569" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Close" Foreground="#334155" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>

        <!-- Bottom-Right Side Overlay for Brand & Style & Size -->
        <components:MasterLookupOverlay x:Name="MasterSideOverlay"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,12,12"
                                          Visibility="Collapsed"/>

        <!-- Bottom-Right Side Overlay: Style x Size Matrix Table -->
        <Border x:Name="VariantMatrixOverlay"
                Background="#FFFFFF"
                BorderBrush="#4F46E5"
                BorderThickness="1.5"
                CornerRadius="6"
                Width="460"
                Height="380"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,12,12"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.38"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="#E0E7FF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtMatrixHeader" Text="Style × Size Matrix (Untick missing)"
                                   Foreground="#1E1B4B" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtMatrixCount" Text="0 active" Foreground="#4338CA"
                                   FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="#475569"
                                BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Padding="3,0"
                                Click="CloseMatrix_Click"/>
                    </Grid>
                </Border>

                <!-- Style x Size DataGrid Table -->
                <DataGrid Grid.Row="1" x:Name="GridVariantMatrix"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="#E2E8F0"
                          BorderThickness="0"
                          Background="#FFFFFF"
                          RowHeight="30"
                          FontSize="12.5"
                          SelectionUnit="Cell"
                          SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#4F46E5"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="#4338CA"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Tick All" Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#C7D2FE"
                                    BorderThickness="1" FontWeight="Bold" FontSize="11" Padding="10,4" Margin="0,0,6,0"
                                    Cursor="Hand" Click="MatrixTickAll_Click"/>
                            <Button Content="Untick All" Background="#FFFFFF" Foreground="#475569" BorderBrush="#CBD5E1"
                                    BorderThickness="1" FontWeight="SemiBold" FontSize="11" Padding="10,4"
                                    Cursor="Hand" Click="MatrixUntickAll_Click"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Done (Enter)" Background="#4F46E5" Foreground="#FFFFFF"
                                BorderThickness="0" FontWeight="Bold" FontSize="11.5" Padding="14,5"
                                Cursor="Hand" Click="CloseMatrix_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
