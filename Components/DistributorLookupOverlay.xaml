<UserControl x:Class="QuickPos.Components.DistributorLookupOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="DistGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Right-side Overlay Card matching GoFrugal Distributor Master list in Blue/Indigo theme -->
    <Border Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="1.5" CornerRadius="6" Width="580" Height="520">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title bar -->
            <Border Grid.Row="0" Background="#E0E7FF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Distributor Master" Foreground="#1E1B4B" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Column="2" x:Name="TxtRecordsCount" Text="Records : 0/0" Foreground="#1E1B4B" FontSize="12.5" FontWeight="Bold" Margin="0,0,14,0"/>
                    <Button Grid.Column="3" Content="✕" Background="Transparent" Foreground="#475569" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4,2" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Row 1: Search Box -->
            <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="6,4">
                <TextBox x:Name="TxtSearch" Background="#FFFFFF" BorderBrush="#4F46E5" BorderThickness="1.5"
                         FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Padding="8,3"
                         TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
            </Border>

            <!-- Row 2: Distributors Table (Sno, Description, Code) -->
            <DataGrid Grid.Row="2" x:Name="GridDistributors"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      BorderThickness="0"
                      Background="#FFFFFF"
                      ColumnHeaderStyle="{StaticResource DistGridHeaderStyle}"
                      MouseDoubleClick="GridDistributors_MouseDoubleClick"
                      PreviewKeyDown="GridDistributors_PreviewKeyDown"
                      SelectionChanged="GridDistributors_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sno" Binding="{Binding Sno}" Width="55">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Description" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 3: Live Address1 Preview Bar (just like GoFrugal bottom bar) -->
            <Border Grid.Row="3" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,1" Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Address1" Foreground="#1E1B4B" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="TxtPreviewAddress" Text="" Foreground="#0F172A" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- Row 4: Footer Hint -->
            <Border Grid.Row="4" Background="#F8FAFC" Padding="10,0">
                <TextBlock Text="↑/↓ Navigate • Enter or Double-Click to Auto-Fill &amp; Edit • Esc to Close"
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
