<UserControl x:Class="QuickPos.Components.MasterLookupOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="MasterHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#4338CA"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                    <Setter Property="Foreground" Value="#1E1B4B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Compact Bottom-Right Overlay Card in Blue/Indigo Theme -->
    <Border Background="#FFFFFF" BorderBrush="#4F46E5" BorderThickness="1.5" CornerRadius="6" Width="350" Height="360">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title Bar -->
            <Border Grid.Row="0" Background="#E0E7FF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtTitle" Text="Select Brand" Foreground="#1E1B4B" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="2" x:Name="TxtCount" Text="0/0" Foreground="#4338CA" FontSize="11.5" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button Grid.Column="3" Content="✕" Background="Transparent" Foreground="#475569" BorderThickness="0"
                            FontWeight="Bold" FontSize="13" Cursor="Hand" Padding="3,0" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- Row 1: Search & Quick Add Bar -->
            <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtSearch" Background="#FFFFFF" BorderBrush="#4F46E5" BorderThickness="1.2"
                             FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Padding="6,3"
                             TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                    <Button Grid.Column="1" Content="+ Add" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0"
                            FontWeight="Bold" FontSize="11" Padding="10,0" Margin="6,0,0,0" Cursor="Hand" Click="AddNew_Click"/>
                </Grid>
            </Border>

            <!-- Row 2: Items List -->
            <DataGrid Grid.Row="2" x:Name="GridItems"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      BorderThickness="0"
                      Background="#FFFFFF"
                      ColumnHeaderStyle="{StaticResource MasterHeaderStyle}"
                      MouseDoubleClick="GridItems_MouseDoubleClick"
                      PreviewKeyDown="GridItems_PreviewKeyDown"
                      SelectionChanged="GridItems_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="ColCheck" Header="✓" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="RowCheck_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sno" Binding="{Binding Sno}" Width="44"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 3: Footer Hint & Apply Button (for Multi-Select) -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtHint" Text="↑/↓ • Space/Click Check • Enter Done"
                               Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BtnDone" Content="Apply (Enter)" Background="#4F46E5" Foreground="#FFFFFF"
                            BorderThickness="0" FontWeight="Bold" FontSize="11" Padding="10,4" Cursor="Hand" Click="Done_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
